# ---------------------------------------------------------------------------
# AuraMed environment configuration — copy to `.env` and fill in.
# NEVER commit the real .env (it is git-ignored).
# ---------------------------------------------------------------------------

# Runtime
AURAMED_ENV=development                 # development | staging | production
AURAMED_HOST=0.0.0.0
AURAMED_PORT=8000
AURAMED_LANGUAGE=en                     # en | bn (default UI/output language)

# Security (Node 16) — 32-byte key as 64 hex chars. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AURAMED_ENCRYPTION_KEY=
# Token required by physicians/auditors to read the regulatory audit trail (Node 26)
AURAMED_AUDIT_TOKEN=change-me-audit-token

# Storage / cache
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://auramed:auramed@localhost:5432/auramed
AURAMED_DATA_DIR=./data

# Dual-AI Consensus Engine (Node 08)
# Leave endpoints BLANK to run the built-in deterministic local rule-based
# models (safe for offline edge nodes / tests / demos).
AURAMED_LLM_A_ENDPOINT=                 # e.g. https://llm-a.internal/v1/chat/completions
AURAMED_LLM_B_ENDPOINT=                 # e.g. https://llm-b.internal/v1/chat/completions
AURAMED_LLM_A_KEY=
AURAMED_LLM_B_KEY=
AURAMED_CONSENSUS_TIMEOUT=8.0
AURAMED_MIN_CONFIDENCE=0.65

# Edge / offline mode (Node 21) — when 1, cloud-only features degrade gracefully
AURAMED_OFFLINE=0
